# .env.example
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# ── Anthropic (obrigatório) ───────────────────────────────────────────────
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Telegram Bot (opcional, para alertas) ────────────────────────────────
# 1. Fale com @BotFather no Telegram → /newbot → copie o token
# 2. Para obter seu chat_id: fale com @userinfobot no Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ-abcdefgh

# IDs separados por vírgula (seu chat pessoal e/ou grupos)
# Para grupos, o ID começa com -100
TELEGRAM_CHAT_IDS=-1001234567890,987654321

# ── Banco de dados ────────────────────────────────────────────────────────
# SQLite (padrão, sem configuração):
DATABASE_PATH=licitacoes.db

# PostgreSQL (produção) — descomente e ajuste:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/licitacoes

# ── Configurações de coleta ───────────────────────────────────────────────
# A cada quantas horas rodar o ciclo de coleta+análise
INTERVALO_COLETA_HORAS=4

# Score mínimo (0-100) para disparar alerta no Telegram
SCORE_MINIMO_ALERTA=65

# ── API REST ──────────────────────────────────────────────────────────────
# Porta do servidor FastAPI (dashboard web)
API_PORT=8000
API_HOST=0.0.0.0
