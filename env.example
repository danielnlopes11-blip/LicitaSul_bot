# .env.example
# Copie para .env e preencha: cp .env.example .env

# ── Provider de IA (escolha um) ───────────────────────────────────────────
IA_PROVIDER=groq       # opções: groq | gemini

# ── Groq (gratuito) ───────────────────────────────────────────────────────
# Obter key grátis: https://console.groq.com → API Keys
# Limites gratuitos: 14.400 req/dia · 6.000 tokens/min
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GROQ_MODEL=llama-3.3-70b-versatile
# Outros modelos Groq disponíveis:
# llama-3.1-8b-instant      (mais rápido, menor)
# mixtral-8x7b-32768        (bom para textos longos)
# gemma2-9b-it              (Google via Groq)

# ── Gemini — Google AI Studio (gratuito) ──────────────────────────────────
# Obter key grátis: https://aistudio.google.com/apikey
# Limites gratuitos: 1.500 req/dia · 1M tokens/min (flash)
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-2.0-flash
# Outros modelos Gemini disponíveis:
# gemini-1.5-flash           (estável, contexto 1M tokens)
# gemini-1.5-pro             (mais capaz, limite menor)
# gemini-2.0-flash-thinking  (raciocínio avançado)

# ── Telegram Bot (opcional) ───────────────────────────────────────────────
# 1. Fale com @BotFather no Telegram → /newbot → copie o token
# 2. Seu chat_id: fale com @userinfobot no Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_IDS=123456789
# Para grupos (ID começa com -100):
# TELEGRAM_CHAT_IDS=123456789,-1001234567890

# ── Banco de dados ────────────────────────────────────────────────────────
DATABASE_PATH=licitacoes.db

# ── Coleta e alertas ──────────────────────────────────────────────────────
INTERVALO_COLETA_HORAS=4
SCORE_MINIMO_ALERTA=65

# ── API REST ──────────────────────────────────────────────────────────────
API_PORT=8000
API_HOST=0.0.0.0
